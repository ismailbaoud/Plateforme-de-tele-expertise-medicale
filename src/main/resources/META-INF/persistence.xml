<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="MyPU" transaction-type="RESOURCE_LOCAL">

        <!-- Entities -->
        <class>com.medicale.consultation.consultationmedicale.models.person.Patient</class>
        <class>com.medicale.consultation.consultationmedicale.models.person.Specialist</class>
        <class>com.medicale.consultation.consultationmedicale.models.person.Generalist</class>
        <class>com.medicale.consultation.consultationmedicale.models.person.Nurse</class>

        <class>com.medicale.consultation.consultationmedicale.models.consultation.Consultation</class>
        <class>com.medicale.consultation.consultationmedicale.models.consultation.MedicaleAct</class>
        <class>com.medicale.consultation.consultationmedicale.models.consultation.Request</class>

        <class>com.medicale.consultation.consultationmedicale.models.Ticket</class>
        <class>com.medicale.consultation.consultationmedicale.models.MedicaleFile</class>

        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <properties>
            <!-- ✅ MariaDB connection -->
            <property name="jakarta.persistence.jdbc.driver" value="org.mariadb.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mariadb://localhost:3306/hospital?createDatabaseIfNotExist=true&amp;useSSL=false&amp;serverTimezone=UTC"/>
            <property name="jakarta.persistence.jdbc.user" value="ismail"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <!-- ✅ Hibernate settings -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.MariaDBDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>

</persistence>
